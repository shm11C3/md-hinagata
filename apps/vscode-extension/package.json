{
  "name": "md-hinagata-vscode-extension",
  "displayName": "md-hinagata",
  "publisher": "Shm11C3",
  "version": "0.1.3",
  "private": true,
  "description": "Convert Markdown into theme-controlled HTML fragments in VS Code.",
  "license": "MIT OR Apache-2.0",
  "icon": "resources/md-hinagata.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/shm11C3/md-hinagata.git",
    "directory": "apps/vscode-extension"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "html",
    "converter",
    "templates",
    "handlebars",
    "theme"
  ],
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md",
    "dist/extension.js",
    "package.json",
    "resources/md-hinagata.png",
    "resources/md-hinagata.svg",
    "themes/**",
    "wasm/md_hinagata_wasm.js",
    "wasm/md_hinagata_wasm_bg.wasm",
    "wasm/package.json"
  ],
  "type": "module",
  "engines": {
    "vscode": "^1.120.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Workspace themes loaded from the workspace are disabled in untrusted workspaces. Bundled themes, preview, and copy behavior remain available."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "md-hinagata.openPreview",
        "title": "Open Preview",
        "category": "md-hinagata"
      },
      {
        "command": "md-hinagata.copyGeneratedHtml",
        "title": "Copy Generated HTML",
        "category": "md-hinagata"
      },
      {
        "command": "md-hinagata.selectTheme",
        "title": "Select Theme",
        "category": "md-hinagata"
      },
      {
        "command": "md-hinagata.createThemeFromDefault",
        "title": "Create Theme from Default",
        "category": "md-hinagata"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "md-hinagata",
          "title": "md-hinagata",
          "icon": "resources/md-hinagata.svg"
        }
      ]
    },
    "views": {
      "md-hinagata": [
        {
          "id": "md-hinagata.themeManager",
          "name": "Theme Manager",
          "type": "webview",
          "icon": "resources/md-hinagata.svg"
        }
      ]
    }
  },
  "scripts": {
    "bench": "vitest bench",
    "build": "node --experimental-strip-types ./esbuild.config.ts",
    "build:release": "node --experimental-strip-types ./esbuild.config.ts --release",
    "check": "tsc --noEmit",
    "format": "pnpm --workspace-root exec biome format --write apps/vscode-extension",
    "lint": "pnpm --workspace-root exec biome check apps/vscode-extension",
    "test": "vitest run",
    "vscode:prepublish": "pnpm --workspace-root run prepare:vscode-extension-package",
    "test:e2e": "pnpm run build && pnpm run test:e2e:build && node --experimental-strip-types ./test/e2e/run.ts",
    "test:e2e:build": "node --experimental-strip-types ./test/e2e/esbuild.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.120.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
