{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run md-hinagata Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode-extension/dist/**/*.js"],
      "preLaunchTask": "md-hinagata: build extension"
    },
    {
      "name": "Run md-hinagata Extension (Basic Example)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension",
        "${workspaceFolder}/examples/basic",
        "--goto",
        "${workspaceFolder}/examples/basic/article.md:1"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode-extension/dist/**/*.js"],
      "preLaunchTask": "md-hinagata: prepare basic example"
    }
  ]
}
